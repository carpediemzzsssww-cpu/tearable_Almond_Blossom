{
  "name": "almond-pouch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "verify": "node scripts/verify.mjs",
    "build:minitool": "tsc --noEmit && vite build --config vite.minitool.config.ts && node scripts/minitool/prepare.mjs && node scripts/minitool/package-minitool.mjs --force",
    "preview:minitool": "node scripts/minitool/serve-csp.mjs",
    "verify:minitool": "node scripts/minitool/verify.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
